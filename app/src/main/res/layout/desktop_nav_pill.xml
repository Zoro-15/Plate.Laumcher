<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/desktop_nav_pill"
    android:layout_width="wrap_content"
    android:layout_height="30dp"
    android:layout_gravity="bottom|end"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_desktop_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/btn_nav_menu"
        android:layout_width="28dp"
        android:layout_height="24dp"
        android:padding="3dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_nav_menu"
        android:tint="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/btn_nav_home"
        android:layout_width="28dp"
        android:layout_height="24dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:padding="3dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_nav_home"
        android:tint="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/btn_nav_back"
        android:layout_width="28dp"
        android:layout_height="24dp"
        android:padding="3dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_nav_back"
        android:tint="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@null" />

</LinearLayout>
