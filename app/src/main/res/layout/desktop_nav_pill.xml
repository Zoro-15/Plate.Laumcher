<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/desktop_nav_pill"
    launcher:layout_ignoreInsets="true"
    android:layout_width="38dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical|end"
    android:layout_marginEnd="0dp"
    android:background="@drawable/bg_desktop_nav_tab"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/btn_nav_menu"
        android:layout_width="30dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_nav_menu"
        android:tint="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/btn_nav_home"
        android:layout_width="30dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:padding="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_nav_home"
        android:tint="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/btn_nav_back"
        android:layout_width="30dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_nav_back"
        android:tint="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@null" />

</LinearLayout>
