<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.desktop.StatusPillView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/desktop_status_pill"
    launcher:layout_ignoreInsets="true"
    android:layout_width="wrap_content"
    android:layout_height="20dp"
    android:layout_gravity="top|end"
    android:layout_marginTop="1dp"
    android:layout_marginEnd="2dp"
    android:background="@drawable/bg_desktop_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:clickable="true"
    android:focusable="true">

    <TextClock
        android:id="@+id/clock_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEE h:mm a"
        android:format24Hour="EEE HH:mm"
        android:textColor="#FFFFFFFF"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:text="|"
        android:textColor="#55FFFFFF"
        android:textSize="9sp" />

    <ImageView
        android:id="@+id/battery_icon"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="3dp"
        android:src="@drawable/ic_battery"
        android:tint="#FFFFFFFF"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/battery_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--%"
        android:textColor="#FFFFFFFF"
        android:textSize="9sp"
        android:textStyle="bold" />

</com.android.launcher3.desktop.StatusPillView>
